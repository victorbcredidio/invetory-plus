{
	"manifest_version": 2.0,
	"id": "inventory_plus",
	"name": "Inventory Plus",
	"namespace": "InventoryPlus",
	"version": "1.1.1",
	"author": "Victor Credidio",
	"description": "Improved host inventory visualization: Explorer (any column, multi-condition filters, CSV export), Analytics (distributions, cross-tabs, field fill rate) and a sectioned Host card. Read-only.",
	"actions": {
		"inventoryplus.explorer": {
			"class": "Explorer",
			"view": "inventoryplus.explorer",
			"layout": "layout.htmlpage"
		},
		"inventoryplus.explorer.export": {
			"class": "ExplorerExport",
			"layout": "layout.json"
		},
		"inventoryplus.analytics": {
			"class": "Analytics",
			"view": "inventoryplus.analytics",
			"layout": "layout.htmlpage"
		},
		"inventoryplus.host": {
			"class": "HostCard",
			"view": "inventoryplus.host",
			"layout": "layout.htmlpage"
		}
	},
	"config": {
		"added_on_visible_to": "all",
		"default_columns": ["type", "vendor", "model", "os", "serialno_a", "site_city", "_added_on", "_completeness"]
	}
}
